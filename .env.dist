# WSPBDBot - Whisper Bot (PPBBot style)
# Copy to .env and fill: cp .env.dist .env

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=123452345243:Asdfasdfasf

# Admin IDs (comma separated) - can view all whispers via Telegram + Dashboard
ADMINS=12345678,12345677,12345676

# Optional: hosting ip
ip=localhost

# Optional: Neon PostgreSQL (leave empty for local SQLite manager.db)
DATABASE_URL=

# Dashboard (admin viewer) - web panel at /admin
ADMIN_PASSWORD=change_this_strong_password
DASHBOARD_PORT=8000
DASHBOARD_SECRET=random_secret_key_change_me

# Optional: forward whisper read logs to admins (0/1)
NOTIFY_ADMINS=0
DEBUG_SQL=0
